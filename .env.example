# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_SECONDARY_FALLBACK=gemini-2.5-flash-lite

# Excel Configuration
EXCEL_TEMPLATE_PATH=Book3.xlsx
EXCEL_SHEET_NAME=AP BLR

# Storage & Samples
SQLITE_DB_PATH=invoice_automation.db
INVOICE_SAMPLES_DIR=samples inv

# Ports
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Microsoft Graph API (Optional - for future Outlook sync)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_USER_MAILBOX=

